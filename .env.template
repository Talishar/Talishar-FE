# if you've got different settings than from docker

VITE_ENV="dev"
VITE_BACKEND_URL="localhost"
VITE_BACKEND_PORT="8080"
VITE_BACKEND_DIRECTORY="game"
VITE_DATADOLL_URL="localhost"
VITE_DATADOLL_PORT="8090"
VITE_ROGUELIKE_URL="localhost"
VITE_ROGUELIKE_PORT="8080"
VITE_ROGUELIKE_DIRECTORY="game"
VITE_FREEZE_GAME=false

# Display ads are enabled everywhere except protected gameplay routes.
VITE_ADS_ENABLED=true

# Metafy OAuth Configuration
# Get your client ID from https://metafy.gg/account/settings/oauth
# Use the "Talishar Login" app for frontend login flow
VITE_METAFY_CLIENT_ID=mq4BefpUIWArURG8QOd1_oRfijB7BjzEmHNJf-yZmn0
# Optional exact OAuth callback for a non-production deployment. It must be
# registered in the corresponding Metafy OAuth application and match the
# backend METAFY_LOGIN_REDIRECT_URI value. If absent, the current site origin
# is used.
VITE_METAFY_LOGIN_REDIRECT_URI=
# Optional same-origin endpoint that receives Web Vitals and Talishar's
# action/SSE timing metrics. Leave empty to keep metrics browser-local.
VITE_PERFORMANCE_ENDPOINT=
