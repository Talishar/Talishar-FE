{
  "ABOUT": {
    "COMMUNITY": {
      "DESCRIPTION": "Talishar prospère grâce à la collaboration avec d'autres développeurs talentueux de la communauté FAB :",
      "FAB_CARD_DATABASE_DESCRIPTION": "Base de données open-source avec représentations JSON/CSV des cartes Flesh & Blood.",
      "FAB_INSIGHTS_DESCRIPTION": "Analyse statistique avancée de la méta, des interactions des héros et des données de gameplay Talishar.",
      "FABLAZING_DATA_DESCRIPTION": "Découvrez le paysage méta actuel et accédez à des statistiques détaillées sur héros et decks.",
      "FABRARY_DESCRIPTION": "L'outil de recherche, construction de decks et gestion de collection de cartes Flesh & Blood le plus avancé.",
      "LEGENDARY_STORIES_DESCRIPTION": "Archive fan-curatée de tous les récits officiels et l’univers Flesh & Blood.",
      "THE_FAB_CUBE_DESCRIPTION": "Créateur de cube facile à utiliser avec base de données complète pour Flesh & Blood TCG.",
      "TITLE": "Créé par la communauté"
    },
    "DESCRIPTION": "Talishar est la plateforme communautaire gratuite basée sur navigateur où plus de 9 000 joueurs par jour s'affrontent en temps réel dans des parties de Flesh & Blood. Apportez votre deck, affrontez des joueurs du monde entier et maîtrisez vos héros.",
    "DISCLAIMER": "<2><1>Avertissement :</1> Talishar est une plateforme open-source créée par des fans, non associée à LSS. Elle peut ne pas représenter complètement les règles telles qu’écrites. Si vous avez des questions sur les interactions ou décisions, veuillez contacter la communauté des juges sur le <3>Discord JudgeHub</3> pour clarification.</2><2>Talishar n’est en aucun cas affilié à Legend Story Studios. Legend Story Studios®, Flesh and Blood™, et les noms de sets sont des marques déposées de Legend Story Studios. Les personnages, cartes, logos et illustrations Flesh and Blood sont la propriété de <4>Legend Story Studios</4>. © Legend Story Studios</2>",
    "FAQ": {
      "BUG_FEATURE_A": "Nous aimons les retours, cette plateforme ne serait pas la même sans eux! Vous pouvez signaler des problèmes ou suggérer des fonctionnalités via notre serveur <a href='https://discord.gg/JykuRkdd5S' target='_blank'>Discord</a>. Les retours des joueurs nous aident à améliorer Talishar.",
      "BUG_FEATURE_Q": "Que faire si je trouve un bug ou si j'ai des suggestions?",
      "DOWNLOAD_NEEDED_A": "Aucun téléchargement nécessaire! Talishar fonctionne directement dans votre navigateur sur ordinateur, tablette ou mobile.",
      "DOWNLOAD_NEEDED_Q": "Dois-je télécharger quelque chose?",
      "HOW_CONTRIBUTER_A": "Talishar est un projet open-source. Rejoignez notre canal Discord #dev-general pour participer et consultez notre <a href='https://github.com/Talishar/Talishar/blob/main/README.md' target='_blank'>GitHub</a> pour les directives de contribution.",
      "HOW_CONTRIBUTER_Q": "Comment puis-je devenir contributeur?",
      "HOW_SIGNUP_A": "Cliquez sur le bouton 'S'inscrire' sur la page principale et entrez votre email et mot de passe. Votre compte est créé instantanément et vous pouvez commencer à jouer immédiatement.",
      "HOW_SIGNUP_Q": "Comment créer un compte?",
      "IS_FREE_A": "Oui! Talishar est entièrement gratuit. Vous pouvez profiter de toutes les fonctionnalités sans dépenser d'argent. Nous proposons des cosmétiques exclusifs pour nos soutiens et ceux qui souhaitent aider au financement du développement.",
      "IS_FREE_Q": "Talishar est-il gratuit?",
      "IS_OFFICIAL_A": "Talishar est une plateforme communautaire non officielle. Elle n'est pas affiliée à Legend Story Studios.",
      "IS_OFFICIAL_Q": "S'agit-il d'une plateforme officielle de Flesh & Blood?",
      "PLAY_OFFLINE_A": "Talishar est une plateforme en ligne qui nécessite une connexion Internet pour jouer. Cela vous permet de jouer contre de vrais joueurs dans le monde entier en temps réel.",
      "PLAY_OFFLINE_Q": "Puis-je jouer hors ligne?",
      "TITLE": "Questions Fréquemment Posées",
      "WHERE_PLAY_A": "Consultez le <a href='https://fabtcg.com/locator/?tab=event&privateMode=false' target='_blank'>localisateur d'événements officiel LSS</a> pour trouver des tournois et événements locaux.",
      "WHERE_PLAY_Q": "Où puis-je jouer en personne?",
      "WHY_NO_RANKED_A": "Talishar est conçu comme une plateforme d'essai sans enjeu pour permettre aux joueurs d'expérimenter des decks et stratégies. Si vous souhaitez jouer de manière compétitive, rendez-vous sur <a href='https://fabtcg.com/organised-play/' target='_blank'>les tournois officiels</a> et participez aux compétitions Flesh & Blood!",
      "WHY_NO_RANKED_Q": "Pourquoi n'y a-t-il pas de matchmaking ou de parties classées?"
    },
    "FEATURES": {
      "ACTIVE_DESCRIPTION": "Rejoignez plus de 9 000 joueurs actifs chaque jour dans le monde entier",
      "ACTIVE_TITLE": " Communauté active",
