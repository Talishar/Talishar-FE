# Cache policy for the Vite-built SPA (Cloudflare Pages / Netlify style header rules).
# See public/.htaccess for the same policy's rationale (Apache deploys).

/index.html
  Cache-Control: no-cache, no-store, must-revalidate

/manifest.json
  Cache-Control: no-cache, no-store, must-revalidate

/assets/*
  Cache-Control: public, max-age=31536000, immutable
