# Revalidate JavaScript and CSS, including SPA fallbacks for deleted asset
# URLs. Never mark /assets/* immutable until the host returns a true 404 for a
# missing asset instead of serving index.html.
/assets/*.js
  Cache-Control: public, max-age=0, must-revalidate

/playmats/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400

/sounds/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400
